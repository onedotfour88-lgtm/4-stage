{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/notes/:path*", "destination": "/api/notes" },
    { "source": "/api/memos/:path*", "destination": "/api/memos" }
  ]
}